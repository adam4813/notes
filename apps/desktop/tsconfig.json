{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "outDir": "dist-electron",
    "noEmit": false,
    "declaration": false,
    "lib": ["ES2022"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist-electron", "node_modules"]
}
