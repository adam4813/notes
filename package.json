{
  "name": "notes",
  "version": "0.0.11",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace @notes/server run dev",
    "dev:web": "npm --workspace @notes/web run dev",
    "dev:desktop": "npm --workspace @notes/desktop run dev",
    "dev:all": "concurrently -n server,web,electron -c blue,green,yellow \"npm:dev:server\" \"npm:dev:web\" \"npm:dev:desktop\"",
    "build": "npm --workspace @notes/web run build",
    "build:server-bundle": "npm --workspace @notes/desktop run build:server-bundle",
    "build:electron-main": "npm --workspace @notes/desktop run build:electron-main",
    "prebuild-native": "npm --workspace @notes/desktop run prebuild-native",
    "build:desktop": "npm run build && npm run prebuild-native && npm run build:server-bundle && npm run build:electron-main",
    "package:desktop": "npm run build:desktop && npm --workspace @notes/desktop run package",
    "package:desktop:win": "npm run build:desktop && npm --workspace @notes/desktop run package:win",
    "package:desktop:mac": "npm run build:desktop && npm --workspace @notes/desktop run package:mac",
    "package:desktop:linux": "npm run build:desktop && npm --workspace @notes/desktop run package:linux",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@tiptap/core": "^3.27.4",
    "@tiptap/pm": "^3.27.4",
    "@types/node": "^22.10.1",
    "7zip-bin": "^5.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.12.0",
    "prettier": "^3.4.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.6"
  }
}
